# Copier ce fichier en .env et renseigner les valeurs

# Base de données
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_password

# JWT - obligatoire. Générer une clé aléatoire longue (32 octets minimum) :
#   openssl rand -base64 48
# Aucune valeur par défaut n'est fournie en production.
JWT_SECRET=

# Profil Spring : dev | prod (obligatoire, aucun profil n'est activé par défaut)
SPRING_PROFILES_ACTIVE=dev

# SuperAdmin - créé automatiquement au démarrage s'il est absent.
# Obligatoire en production ; sans valeur, aucun superadmin n'est créé en dev.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
