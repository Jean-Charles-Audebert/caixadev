# Copier ce fichier en .env et renseigner les valeurs

# Base de données
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_password

# JWT — générer une clé aléatoire longue pour la production (min 32 chars)
JWT_SECRET=changeme-this-is-a-very-long-secret-key-for-dev-only-32chars

# Profil Spring : dev | prod
SPRING_PROFILES_ACTIVE=dev

# SuperAdmin (créé automatiquement au démarrage si absent)
SUPER_ADMIN_EMAIL=jc1932@gmail.com
SUPER_ADMIN_PASSWORD=

